# Copiá este archivo a .env y completá los valores. .env nunca se sube al repositorio.

# --- Modo de ejecución ---
# true = genera todo pero NO publica (recomendado para pruebas)
DRY_RUN=true
# simulado = backend falso local; mcp = ootto real (pendiente de implementar, Fase 3)
OOTTO_MODO=simulado

# --- ootto ---
OOTTO_API_KEY=
OOTTO_BASE_URL=

# --- Cuentas (tokens solo para métricas, Fase 4) ---
META_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ID=
TIKTOK_ACCESS_TOKEN=

# --- Notificaciones de error ---
# Webhook compatible con Slack, Discord o Google Chat (recibe {"text": "..."}). Vacío = solo log.
NOTIFY_WEBHOOK_URL=

# --- Rutas y logs ---
DATA_DIR=data
SALIDA_DIR=salida
LOG_LEVEL=INFO

# --- Solo pruebas: forzar fallos en el backend simulado ---
# Formato: paso[:veces],paso...  Pasos: hooks, guion, graficos, motion, musica, publicar
# Ej.: motion:1 falla una vez (el reintento lo resuelve); motion falla siempre.
OOTTO_SIM_FALLOS=
