# Copiá este archivo como .env y completá los valores. El .env nunca se sube a git.

# Modo simulación: true = genera todo pero NO publica nada.
DRY_RUN=true

# Texto (LLM local)
OLLAMA_HOST=http://127.0.0.1:11434

# Voz en la nube (capas gratis con uso comercial). Ver docs/guia-voces.md
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
GOOGLE_TTS_API_KEY=

# Avisos por correo (Fase 2)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_TO=contacto@iftechworks.com

# Instagram (Fase 3)
IG_USER_ID=
IG_ACCESS_TOKEN=

# TikTok (Fase 3)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=

# Imágenes de apoyo opcionales
PEXELS_API_KEY=
