# Entorno y credenciales
.env
.venv/
.venv-tts/
__pycache__/
*.pyc

# Datos generados (piezas, base de datos, modelos descargados)
data/
models/

# Sistema
.DS_Store
Thumbs.db

# Intermedios de render
**/work/
examples/piezas/**/html/

# Voces reales (datos personales: nunca a GitHub)
assets/voice/*
!assets/voice/README.md

# Renders con voces reales o clonadas de personas (datos personales)
prototypes/direcciones/b-conversacion/*.mp4
prototypes/direcciones/b-voz/reel.mp4

# Campañas de clientes: material, voces y renders (datos del cliente, fuera de git)
campanas/*/material/
campanas/*/salida/
campanas/*/entregas/

# Música compuesta para clientes: solo el mp3 va a git
campanas/*/musica/*.wav
