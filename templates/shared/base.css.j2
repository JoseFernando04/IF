/* Generado desde config/brand.json. No editar colores aquí: editá brand.json. */
@font-face { font-family: "{{ brand.fonts.heading.family }}"; src: url("{{ fonts_uri }}/{{ brand.fonts.heading.file }}"); font-weight: 300 700; }
@font-face { font-family: "{{ brand.fonts.body.family }}"; src: url("{{ fonts_uri }}/{{ brand.fonts.body.file }}"); font-weight: 100 900; }
@font-face { font-family: "{{ brand.fonts.mono.family }}"; src: url("{{ fonts_uri }}/{{ brand.fonts.mono.file }}"); font-weight: 100 800; }

:root {
{%- for k, v in brand.colors.items() %}
  --{{ k | replace('_', '-') }}: {{ v }};
{%- endfor %}
  --radius: {{ brand.style.radius_px }}px;
  --f-head: "{{ brand.fonts.heading.family }}", sans-serif;
  --f-body: "{{ brand.fonts.body.family }}", sans-serif;
  --f-mono: "{{ brand.fonts.mono.family }}", monospace;
}

* { box-sizing: border-box; margin: 0; padding: 0; }
html, body { width: {{ width }}px; height: {{ height }}px; overflow: hidden; }
body {
  background: var(--bg);
  color: var(--text);
  font-family: var(--f-body);
  -webkit-font-smoothing: antialiased;
  position: relative;
}

/* Fondo de marca: degradado bosque, cuadrícula sutil y brillo dorado. */
.bg { position: absolute; inset: 0; overflow: hidden;
  background: radial-gradient(120% 80% at 50% 0%, var(--surface-alt) 0%, var(--bg-alt) 45%, var(--bg) 100%); }
{% if brand.style.grid %}
.bg::before { content: ""; position: absolute; inset: 0;
  background-image: linear-gradient(rgba(254,252,243,.045) 1px, transparent 1px),
                    linear-gradient(90deg, rgba(254,252,243,.045) 1px, transparent 1px);
  background-size: 72px 72px;
  mask-image: radial-gradient(ellipse at 50% 40%, #000 30%, transparent 80%); }
{% endif %}
{% if brand.style.glow %}
.glow { position: absolute; width: 900px; height: 900px; border-radius: 50%;
  background: radial-gradient(circle, rgba(240,196,25,.20) 0%, rgba(240,196,25,0) 65%); filter: blur(40px); }
{% endif %}

.accent { color: var(--accent); }
.badge { font-family: var(--f-mono); font-size: 26px; letter-spacing: .04em; color: var(--accent);
  border: 1.5px solid rgba(240,196,25,.45); background: rgba(240,196,25,.08);
  padding: 12px 22px; border-radius: 999px; display: inline-block; }

/* Logo tipográfico: reproduce el logo del sitio en vector. */
.wordmark { display: inline-flex; flex-direction: column; align-items: center; line-height: 1; color: var(--text); }
.wordmark .if { font-family: var(--f-head); font-weight: 700; letter-spacing: -.02em; }
.wordmark .tw { font-family: var(--f-head); font-weight: 600; letter-spacing: .22em; margin-top: .12em; padding-left: .22em; }

.icon svg { width: 100%; height: 100%; display: block; }
.icon-chip { display: grid; place-items: center; border-radius: 32%;
  background: linear-gradient(145deg, rgba(240,196,25,.22), rgba(240,196,25,.06));
  border: 1.5px solid rgba(240,196,25,.4); color: var(--accent); }
