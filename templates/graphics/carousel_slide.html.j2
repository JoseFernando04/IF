<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<style>
{{ base_css }}

.frame { position: absolute; inset: 0; padding: 96px 92px 88px; display: flex; flex-direction: column; }
.top { display: flex; justify-content: space-between; align-items: center; }
.top .wordmark .if { font-size: 44px; }
.top .wordmark .tw { font-size: 11px; }
.counter { font-family: var(--f-mono); font-size: 26px; color: var(--muted); }
.counter b { color: var(--accent); font-weight: 500; }

.main { flex: 1; display: flex; flex-direction: column; justify-content: center; }
h1 { font-family: var(--f-head); font-weight: 700; letter-spacing: -.025em; line-height: 1.02; }
p.body { font-size: 40px; line-height: 1.42; color: var(--text-soft); opacity: .88; max-width: 860px; }

/* Portada */
.cover h1 { font-size: 104px; margin: 44px 0 36px; }
.cover p.body { font-size: 38px; }
.cover .glow { top: -280px; right: -320px; }

/* Contenido */
.content .num { font-family: var(--f-mono); font-size: 30px; color: var(--accent); margin-bottom: 28px; }
.content .icon-chip { width: 132px; height: 132px; padding: 30px; margin-bottom: 44px; }
.content h1 { font-size: 78px; margin-bottom: 34px; }
.content .glow { bottom: -420px; left: -380px; opacity: .8; }
.content .rule { width: 120px; height: 6px; background: var(--accent); border-radius: 3px; margin-bottom: 34px; }

/* CTA */
.cta .main { align-items: center; text-align: center; }
.cta .main .wordmark .if { font-size: 150px; }
.cta .main .wordmark .tw { font-size: 34px; }
.cta h1 { font-size: 80px; margin: 64px 0 26px; }
.cta p.body { font-size: 36px; }
.cta .pills { display: flex; flex-direction: column; gap: 20px; margin-top: 52px; align-items: center; }
.pill { font-family: var(--f-head); font-weight: 600; font-size: 36px; padding: 22px 44px; border-radius: 999px; }
.pill.primary { background: var(--accent); color: var(--bg); }
.pill.ghost { border: 2px solid rgba(254,252,243,.35); color: var(--text); }
.cta .glow { top: 50%; left: 50%; transform: translate(-50%, -50%); }

.bottom { display: flex; justify-content: space-between; align-items: center; font-family: var(--f-mono); font-size: 24px; color: var(--muted); }
.swipe { color: var(--accent); }
.dots { display: flex; gap: 10px; }
.dots i { width: 12px; height: 12px; border-radius: 50%; background: rgba(254,252,243,.22); }
.dots i.on { background: var(--accent); width: 34px; border-radius: 6px; }
</style>
</head>
<body class="{{ slide.kind }}">
<div class="bg"><div class="glow"></div></div>
<div class="frame">
  <div class="top">
    <div class="wordmark"><span class="if">IF</span><span class="tw">TECHWORKS</span></div>
    <div class="counter"><b>{{ '%02d' % index }}</b> / {{ '%02d' % total }}</div>
  </div>

  <div class="main">
  {% if slide.kind == "cover" %}
    <div><span class="badge">{{ pillar_name }}</span></div>
    <h1>{{ slide.heading | accent }}</h1>
    {% if slide.body %}<p class="body">{{ slide.body }}</p>{% endif %}
  {% elif slide.kind == "content" %}
    <div class="num">{{ '%02d' % (index - 1) }} —</div>
    <div class="icon-chip icon">{{ slide.icon | icon }}</div>
    <h1>{{ slide.heading | accent }}</h1>
    <div class="rule"></div>
    <p class="body">{{ slide.body }}</p>
  {% else %}
    <div class="wordmark"><span class="if">IF</span><span class="tw">TECHWORKS</span></div>
    <h1>{{ slide.heading | accent }}</h1>
    {% if slide.body %}<p class="body">{{ slide.body }}</p>{% endif %}
    <div class="pills">
      <span class="pill primary">WhatsApp {{ brand.whatsapp }}</span>
      <span class="pill ghost">{{ brand.website }}</span>
    </div>
  {% endif %}
  </div>

  <div class="bottom">
    <span>{{ brand.instagram }}</span>
    <div class="dots">{% for i in range(1, total + 1) %}<i class="{{ 'on' if i == index }}"></i>{% endfor %}</div>
    <span class="swipe">{{ 'Deslizá →' if index < total else brand.tagline }}</span>
  </div>
</div>
</body>
</html>
